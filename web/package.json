{
  "name": "news-webapp",
  "version": "2.0.0",
  "description": "News web application: Svelte + Connect-ES grpc-web client, served by Hono with grpc-web-middleware",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server/index.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "2.1.8",
    "grpc-web-middleware": "1.0.0",
    "hono": "4.13.18"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "2.17.0",
    "@connectrpc/connect": "2.3.0",
    "@connectrpc/connect-web": "2.3.0",
    "@picocss/pico": "2.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.9",
    "@types/node": "26.6.6",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  }
}
